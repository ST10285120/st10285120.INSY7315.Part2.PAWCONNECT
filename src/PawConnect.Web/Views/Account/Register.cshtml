@model RegisterVm
@{ ViewBag.Title = "Register"; }
<div class="page-head"><div class="wrap"><h1>Create your account</h1></div></div>
<div class="content wrap">
  <div class="tabs">
    <a href="/Account/Login@(Model.ReturnUrl != null ? "?returnUrl=" + Uri.EscapeDataString(Model.ReturnUrl) : "")">Log in</a>
    <a href="/Account/Register" class="active" aria-current="page">Register</a>
  </div>
  <form class="form-card" asp-action="Register" asp-controller="Account" method="post">
    <partial name="_ValidationSummary" />
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="field-row">
      <div class="field"><label asp-for="FirstName"></label><input asp-for="FirstName" autocomplete="given-name" /><span asp-validation-for="FirstName" class="field-error"></span></div>
      <div class="field"><label asp-for="LastName"></label><input asp-for="LastName" autocomplete="family-name" /><span asp-validation-for="LastName" class="field-error"></span></div>
    </div>
    <div class="field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span></div>
    <div class="field"><label asp-for="Phone"></label><input asp-for="Phone" autocomplete="tel" placeholder="083 000 0000" /><span asp-validation-for="Phone" class="field-error"></span></div>
    <div class="field">
      <label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" />
      <span class="hint">At least 8 characters with an uppercase letter, a lowercase letter and a number.</span>
      <span asp-validation-for="Password" class="field-error"></span>
    </div>
    <div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="field-error"></span></div>
    <div class="field">
      <label class="check"><input type="checkbox" name="AcceptPrivacy" value="true" checked="@Model.AcceptPrivacy" /> I have read the <a href="/Home/Privacy" target="_blank" rel="noopener">privacy notice</a> and consent to Hope &amp; Paws processing my details for adoptions and donations.</label>
      <span asp-validation-for="AcceptPrivacy" class="field-error"></span>
    </div>
    <button class="btn btn-primary btn-block" type="submit">Create account</button>
  </form>
</div>
