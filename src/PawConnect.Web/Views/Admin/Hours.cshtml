@model HoursAdminVm
@{
    ViewBag.Title = "Volunteer hours";
    var max = Model.ChartData.Count > 0 ? Math.Max(1m, Model.ChartData.Max(c => c.Hours)) : 1m;
}
<div class="page-head"><div class="wrap"><h1>Volunteer hours</h1><p style="margin:0;opacity:.85;">Review logged hours and keep an accurate record for funder reporting.</p></div></div>
<partial name="_AdminSubNav" />
<div class="content wrap">
  <div class="panel-grid">
    <div>
      <form method="get" action="/Admin/Hours" class="filter-row">
        <label class="sr-only" for="vol">Volunteer</label>
        <select id="vol" name="volunteerId">
          <option value="">All volunteers</option>
          @foreach (var v in Model.Volunteers) { <option value="@v.Id" selected="@(Model.SelectedVolunteerId == v.Id)">@v.FullName</option> }
        </select>
        <label class="sr-only" for="st">Status</label>
        <select id="st" name="status">
          <option value="all" selected="@(Model.SelectedStatus == "all")">Any status</option>
          @foreach (var s in Enum.GetValues<HourLogStatus>()) { <option value="@s" selected="@(Model.SelectedStatus == s.ToString())">@s</option> }
        </select>
        <button class="btn btn-ink btn-sm" type="submit">Filter</button>
      </form>

      @if (Model.Logs.Count == 0)
      {
        <div class="empty-hint">No hour logs match those filters.</div>
      }
      else
      {
        <div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable table">
        <table class="data-table">
          <thead><tr><th>Volunteer</th><th>Date</th><th>Activity</th><th>Hours</th><th>Status</th><th>Notes</th><th><span class="sr-only">Actions</span></th></tr></thead>
          <tbody>
          @foreach (var log in Model.Logs)
          {
            <tr>
              <td>@log.Volunteer?.FullName</td>
              <td>@log.Date.ToString("yyyy-MM-dd")</td>
              <td>@log.Activity</td>
              <td class="mono">@log.Hours.ToString("0.##")h</td>
              <td><span class="stamp stamp-@(log.Status.ToString().ToLower())">@log.Status</span></td>
              <td style="max-width:220px;color:var(--ink-soft);font-size:.82rem;">@log.Notes</td>
              <td>
                @if (log.Status == HourLogStatus.Pending)
                {
                  <form asp-action="DecideHours" method="post" style="display:inline-flex;gap:6px;">
                    <input type="hidden" name="id" value="@log.Id" />
                    <input type="hidden" name="volunteerId" value="@Model.SelectedVolunteerId" />
                    <input type="hidden" name="status" value="@Model.SelectedStatus" />
                    <button class="btn btn-ink btn-sm" name="decision" value="approve" type="submit">Approve</button>
                    <button class="btn btn-ghost btn-sm" name="decision" value="reject" type="submit">Reject</button>
                  </form>
                }
              </td>
            </tr>
          }
          </tbody>
        </table>
        </div>
      }
    </div>
    <div>
      <div class="mini-stat"><div class="num">@Model.ApprovedThisMonth.ToString("0.#")h</div><div class="lbl">Approved hours this month</div></div>
      <div class="mini-stat"><div class="num">@Model.PendingCount</div><div class="lbl">Logs awaiting review</div></div>
      <div class="form-card" style="max-width:none;margin-top:20px;">
        <h2 style="font-size:1rem;">Approved hours by volunteer</h2>
        @if (Model.ChartData.Count == 0) { <p class="hint">No approved hours yet.</p> }
        else
        {
          <div class="bars" role="img" aria-label="Approved hours per volunteer">
            @foreach (var c in Model.ChartData)
            {
              var h = (int)Math.Round(c.Hours / max * 100);
              <div class="bar-wrap"><div class="bar-val mono">@c.Hours.ToString("0.#")</div><div class="bar" style="height:@(h)%;" title="@c.Name: @c.Hours.ToString("0.#")h"></div><div class="bar-lbl">@c.Name.Split(' ')[0]</div></div>
            }
          </div>
        }
      </div>
    </div>
  </div>
</div>
