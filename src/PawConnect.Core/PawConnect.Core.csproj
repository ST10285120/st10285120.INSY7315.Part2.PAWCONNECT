<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core (domain) layer: entities, enums, business rules and the interfaces the
    other layers implement. It has no dependency on EF Core or the web layer.
    The ASP.NET Core framework reference is only needed for IdentityUser<TKey>.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PawConnect.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
